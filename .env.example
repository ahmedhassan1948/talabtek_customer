# Firebase Configuration
# Get these from Firebase Console > Project Settings > General > Your Apps

# Android App
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=1:project_number:android:app_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_SENDER_ID=your_sender_id

# iOS App
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_IOS_APP_ID=1:project_number:ios:app_id

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Admin API (talabtek.com)
ADMIN_API_BASE_URL=https://talabtek.com/admin
ADMIN_API_KEY=your_admin_api_key

# Payment Gateways
MADA_MERCHANT_ID=your_mada_merchant_id
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
APPLE_PAY_MERCHANT_ID=merchant.com.talabtek.customer

# Notifications
FCM_SERVER_KEY=your_fcm_server_key

# Social Login
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# Analytics
FIREBASE_ANALYTICS_ENABLED=true
CRASHLYTICS_ENABLED=true

# App Configuration
APP_NAME=طلبك
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
DEFAULT_LANGUAGE=ar
DEFAULT_COUNTRY=SA
CURRENCY=SAR

# Feature Flags
ENABLE_GUEST_MODE=true
ENABLE_WALLET=true
ENABLE_LOYALTY=true
ENABLE_FLASH_SALES=true
ENABLE_SCHEDULED_ORDERS=true

# Delivery
DEFAULT_DELIVERY_FEE=5.0
FREE_DELIVERY_THRESHOLD=50.0
MAX_DELIVERY_DISTANCE_KM=25

# OTP
OTP_LENGTH=6
OTP_TIMEOUT_MINUTES=2
OTP_RESEND_DELAY_SECONDS=60

# Cache
CACHE_EXPIRATION_HOURS=24
MAX_CACHE_SIZE_MB=100