rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isRestaurantOwner(restaurantId) {
      return isSignedIn() && exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }
    
    function isDriver() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
      
      // Subcollections
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
      
      match /paymentMethods/{methodId} {
        allow read, write: if isOwner(userId);
      }
      
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId);
      }
      
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Restaurants collection
    match /restaurants/{restaurantId} {
      allow read: if true; // Public read for browsing
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isRestaurantOwner(restaurantId) || isAdmin();
      allow delete: if isRestaurantOwner(restaurantId) || isAdmin();
      
      // Products subcollection
      match /products/{productId} {
        allow read: if true;
        allow create, update, delete: if isRestaurantOwner(restaurantId) || isAdmin();
      }
      
      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if true;
        allow create, update, delete: if isRestaurantOwner(restaurantId) || isAdmin();
      }
      
      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(reviewId) || isAdmin();
      }
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.driverId == request.auth.uid ||
         isRestaurantOwner(resource.data.restaurantId) ||
         isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && 
        (resource.data.userId == request.auth.uid && request.resource.data.status == 'pending') ||
        (resource.data.driverId == request.auth.uid && request.resource.data.status in ['picked_up', 'delivering']) ||
        (isRestaurantOwner(resource.data.restaurantId) && request.resource.data.status in ['confirmed', 'preparing', 'ready']) ||
        isAdmin();
      allow delete: if isAdmin();
      
      // Order tracking subcollection
      match /tracking/{trackingId} {
        allow read: if isSignedIn() && 
          (resource.data.orderId == orderId && 
           (resource.data.userId == request.auth.uid || 
            resource.data.driverId == request.auth.uid ||
            isRestaurantOwner(resource.data.restaurantId)));
        allow create: if isDriver() || isAdmin();
        allow update: if isDriver() || isAdmin();
      }
      
      // Chat messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && 
          (resource.data.orderId == orderId && 
           (resource.data.senderId == request.auth.uid || 
            resource.data.receiverId == request.auth.uid));
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Drivers collection
    match /drivers/{driverId} {
      allow read: if isOwner(driverId) || isAdmin() || 
        (isSignedIn() && exists(/databases/$(database)/documents/orders/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/orders/$(request.auth.uid)).data.driverId == driverId);
      allow create: if isSignedIn() && request.auth.uid == driverId;
      allow update: if isOwner(driverId) || isAdmin();
      allow delete: if isAdmin();
      
      // Location subcollection
      match /locations/{locationId} {
        allow read: if isOwner(driverId) || isAdmin() ||
          (isSignedIn() && exists(/databases/$(database)/documents/orders/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/orders/$(request.auth.uid)).data.driverId == driverId);
        allow create, update: if isOwner(driverId);
      }
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Coupons collection
    match /coupons/{couponId} {
      allow read: if isSignedIn() && 
        (resource.data.isPublic == true || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Wallet transactions
    match /wallet_transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin();
    }

    // Support chats
    match /chats/{chatId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.assignedAgentId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && 
        (resource.data.assignedAgentId == request.auth.uid || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && 
          (resource.data.chatId == chatId && 
           (resource.data.senderId == request.auth.uid || 
            resource.data.receiverId == request.auth.uid));
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(notificationId) || isAdmin();
    }

    // Analytics/Logs (write only for system)
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Cloud Functions
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}