platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('Flutter', 'Generated.xcconfig'),
    File.dirname(__FILE__)
  )

  if File.exist?(generated_xcode_build_settings_path)
    File.foreach(generated_xcode_build_settings_path) do |line|
      matches = line.match(/FLUTTER_ROOT\=(.*)/)
      return matches[1].strip if matches
    end
  end

  ENV['FLUTTER_ROOT'] ||
    '/Users/runner/hostedtoolcache/flutter/stable-3.47.5-arm64/flutter'
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

target 'RunnerTests' do
  inherit! :search_paths
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['GCC_GENERATE_DEBUGGING_SYMBOLS'] = 'NO'
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'

      # Allow non-modular headers for Firebase-related plugin targets.
      if [
        'firebase_messaging',
        'firebase_crashlytics',
        'firebase_core',
        'firebase_auth',
        'firebase_analytics',
        'cloud_firestore',
        'firebase_storage'
      ].include?(target.name)
        config.build_settings[
          'CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'
        ] = 'YES'
      end

      config.build_settings[
        'CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'
      ] = 'NO'
    end

    # Remove the unsupported warning flag from BoringSSL-GRPC.
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        next unless file.settings &&
                    file.settings['COMPILER_FLAGS']

        flags = file.settings['COMPILER_FLAGS'].split
        flags.reject! do |flag|
          flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS'
        end

        file.settings['COMPILER_FLAGS'] = flags.join(' ')
      end
    end
  end
end
